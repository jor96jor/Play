<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="songEntryUiRoot" style="align-items: center; justify-content: center; overflow: visible; width: 192px; padding-top: 4px; padding-bottom: 4px;">
        <ui:VisualElement name="vinylImage" style="background-color: rgba(0, 0, 0, 0); height: 153px; width: 153px; position: absolute; background-image: url(&quot;project://database/Assets/Scenes/SongSelect/SongSelectImages/vinyl-2202325.png?fileID=2800000&amp;guid=e1ddeb129dc193d4c8087d5564ab28de&amp;type=3#vinyl-2202325&quot;); display: none;"/>
        <ui:VisualElement name="innerSongEntryUi" class="listItem backgroundTransition dynamicPanel" style="flex-direction: column; align-items: stretch; justify-content: flex-end; border-top-left-radius: 18px; border-bottom-left-radius: 18px; border-top-right-radius: 18px; border-bottom-right-radius: 18px; height: auto; width: 181px; overflow: hidden; background-color: rgba(15, 18, 28, 0.94); border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-left-color: rgba(255,255,255,0.08); border-right-color: rgba(255,255,255,0.08); border-top-color: rgba(255,255,255,0.08); border-bottom-color: rgba(255,255,255,0.08);">
            <ui:VisualElement name="songImageOuter" style="background-image: url(&quot;project://database/Packages/playshared/Runtime/Graphics/NoCover.png?fileID=2800000&amp;guid=1d183c612f1866943a54609ced7fece7&amp;type=3#NoCover&quot;); -unity-background-scale-mode: scale-and-crop; flex-shrink: 0; min-width: 25px; min-height: 25px; align-items: flex-start; overflow: hidden; width: 179px; height: 179px; border-top-left-radius: 17px; border-top-right-radius: 17px;">
                <ui:VisualElement name="songImageInner" picking-mode="Ignore" class="overlay" style="-unity-background-scale-mode: scale-and-crop;"/>
                <ui:VisualElement name="folderImage" picking-mode="Ignore" class="overlay" style="background-image: url(&quot;project://database/Packages/playshared/Runtime/Graphics/Icons/Folder.png?fileID=2800000&amp;guid=e71a978c024d44a4bb6a7702a64c1cd0&amp;type=3#Folder&quot;); -unity-background-scale-mode: scale-and-crop;">
                    <ui:VisualElement name="folderPreviewImage" picking-mode="Ignore" class="overlay" style="background-image: url(&quot;project://database/Packages/playshared/Runtime/Graphics/NoCover.png?fileID=2800000&amp;guid=1d183c612f1866943a54609ced7fece7&amp;type=3#NoCover&quot;); -unity-background-scale-mode: scale-and-crop;"/>
                </ui:VisualElement>
                <ui:VisualElement name="songEntryDarkOverlay" picking-mode="Ignore" class="overlay" style="flex-grow: 1; border-top-left-radius: 17px; border-top-right-radius: 17px;"/>
                <MaterialIcon tabindex="-1" icon="cloud_off" name="notAvailableInOnlineGameIcon" class="overlay rounded" style="-unity-text-align: middle-center; font-size: 100px;"/>
            </ui:VisualElement>
            <ui:VisualElement name="center" style="padding-top: 8px; padding-right: 8px; padding-bottom: 7px; padding-left: 8px; min-height: 92px;">
                <ui:VisualElement name="songInfoContainer" picking-mode="Ignore" style="min-height: 52px; overflow: hidden;">
                    <ui:Label text="Some very long song title" display-tooltip-when-elided="true" name="songTitle" picking-mode="Ignore" class="ellipsis" style="white-space: normal; -unity-font-style: bold; max-height: 42px; font-size: 16px; color: rgb(248,248,252);"/>
                    <ui:Label text="Some very very long artist name" display-tooltip-when-elided="true" name="songArtist" picking-mode="Ignore" class="smallFont ellipsis" style="white-space: normal; max-height: 30px; color: rgba(225,225,238,0.62); margin-top: 2px;"/>
                </ui:VisualElement>
                <ui:VisualElement name="row" style="background-color: rgba(0, 0, 0, 0); align-items: center; margin-top: 4px;">
                    <ui:VisualElement name="stars" class="mr-auto" style="background-color: rgba(0, 0, 0, 0); justify-content: center; flex-direction: row;">
                        <MaterialIcon tabindex="-1" icon="star" name="songRatingStarIcon" class="secondaryFontColor" style="font-size: 13px;"/>
                        <MaterialIcon tabindex="-1" icon="star" name="songRatingStarIcon" class="secondaryFontColor" style="font-size: 13px;"/>
                        <MaterialIcon tabindex="-1" icon="star" name="songRatingStarIcon" class="secondaryFontColor" style="font-size: 13px;"/>
                        <MaterialIcon tabindex="-1" icon="star" name="songRatingStarIcon" class="secondaryFontColor" style="font-size: 13px;"/>
                        <MaterialIcon tabindex="-1" icon="star" name="songRatingStarIcon" class="secondaryFontColor" style="font-size: 13px;"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="iconBar" class="row">
                        <ui:VisualElement name="songEntryDuetIcon" picking-mode="Ignore" class="secondaryFontColor" style="flex-shrink: 0; width: 22px; height: 22px; background-image: url(&quot;project://database/Assets/Common/Graphics/Icons/DuetIconWithOutline.png?fileID=2800000&amp;guid=0babf1c7d1bbb374d8d09884cc3a4e8a&amp;type=3#DuetIconWithOutline&quot;); -unity-background-scale-mode: scale-to-fit;"/>
                        <MaterialIcon name="songEntryFavoriteIcon" icon="favorite" picking-mode="Ignore" class="secondaryFontColor songSelectSongEntryIcon"/>
                    </ui:VisualElement>
                    <ui:Button display-tooltip-when-elided="true" name="openSongMenuButton" class="squareButton transparentBackgroundColor focusableNavigatorIgnore" style="padding-left: 0; padding-right: 0; padding-top: 0; padding-bottom: 0; border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 0; width: auto; height: auto; margin-left: 2px;">
                        <MaterialIcon tabindex="-1" picking-mode="Ignore" name="openSongMenuIcon" icon="more_vert" class="secondaryFontColor" style="font-size: 18px;"/>
                    </ui:Button>
                    <ui:VisualElement name="iconBar" picking-mode="Ignore" class="mt-auto pb-4" style="align-items: center; flex-direction: column-reverse; position: absolute; right: 0; bottom: 0;">
                        <MaterialIcon name="songEntryAutoGeneratedIcon" icon="auto_awesome" picking-mode="Ignore" class="secondaryFontColor songSelectSongEntryIcon"/>
                        <MaterialIcon name="songEntryRemoteSourceIcon" icon="cloud" picking-mode="Ignore" class="secondaryFontColor songSelectSongEntryIcon"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
