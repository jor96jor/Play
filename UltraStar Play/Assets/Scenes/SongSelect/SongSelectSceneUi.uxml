    <ui:Template name="SongSelectSceneMenuUi" src="project://database/Assets/Scenes/SongSelect/Menus/SongSelectSceneMenuUi.uxml?fileID=9197481963319205126&amp;guid=38423e50b0df7034b9e88057a38c73b7&amp;type=3#SongSelectSceneMenuUi"/>
